  "narrative": {
    "northStar": "The Break Club",
    "overview": "The Break Club is a bright, practical place for colleagues to organize a shared break. Cobalt provides orientation and action, pale blue provides daylight ground, and citron makes a selected roster format easy to recognize. White surfaces, navy text, and explicit labels keep the interface usable during play.\n\nThe system supports light and dark appearances, is bilingual, and is designed for phones and office PCs. Flat tonal surfaces carry hierarchy; controls remain recognizable native buttons, inputs, and selects. Rubik and Noto Sans Arabic share the same functional hierarchy while Arabic receives its own line-height and direction treatment.",
    "keyCharacteristics": [
      "Cobalt actions and navigation; citron roster selection.",
      "Flat pale blue and white work surfaces.",
      "Self-hosted bilingual typography and explicit roster labels.",
      "Visible keyboard focus and responsive shared-screen play."
    ],
    "rules": [
      {
        "name": "Selection Has a Label",
        "body": "Keep roster formats and active teams explicit in text; color supports the label rather than replacing it.",
        "section": "colors"
      },
      {
        "name": "Flat Work Surfaces",
        "body": "Use tonal backgrounds and borders for grouping; shared cards have no shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use native labeled controls and a visible focus outline.",
      "Do retain Arabic RTL layout, Arabic font priority, and direction-aware keyboard tabs.",
      "Do preserve the selected roster label through setup and play.",
      "Do remove animation and transitions when reduced motion is requested."
    ],
    "donts": [
      "Don't hard-code light surfaces into theme-aware components.",
      "Don't replace explicit player, host, or team labels with color alone.",
      "Don't use elevated shadows on shared cards.",
      "Don't rotate the desktop PassWord team panels; opposing orientation belongs to phone table mode."
    ]
  }
}
